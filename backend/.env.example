# SoilSense Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Never commit .env to git.

PORT=3001
NODE_ENV=development

# Firebase Admin SDK
# Get from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Authentication user UID that receives the system administrator role
ADMIN_UID=your-admin-firebase-user-uid

# JWT (used as fallback / session signing)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Python microservices
IMAGE_PROCESSING_URL=http://localhost:5001
FUZZY_ENGINE_URL=http://localhost:5002
# Optional for local development; set the same secret in backend and both Python services.
SERVICE_API_KEY=

# Google Gemini — used server-side to generate assessment-specific fertilizer guidance.
# Get a key from Google AI Studio. Never put this in frontend/.env or the ESP32 sketch.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ESP32
ESP32_DEVICE_API_KEY=soilsense-dev-key

# File upload
MAX_IMAGE_SIZE_MB=10

# CORS (comma-separated frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
