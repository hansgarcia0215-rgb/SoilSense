# SoilSense Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Never commit .env to git.

PORT=3001
NODE_ENV=development

# Firebase Admin SDK
# Get from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# JWT (used as fallback / session signing)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Python microservices
IMAGE_PROCESSING_URL=http://localhost:5001
FUZZY_ENGINE_URL=http://localhost:5002

# ESP32
ESP32_DEVICE_API_KEY=soilsense-dev-key

# File upload
MAX_IMAGE_SIZE_MB=10

# CORS (comma-separated frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
